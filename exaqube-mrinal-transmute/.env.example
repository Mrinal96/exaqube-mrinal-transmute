APP_NAME=Transmute API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_PREFIX=/api
BACKEND_PORT=8000
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_MAX_RETRY_DELAY_SECONDS=60
LLM_INPUT_COST_PER_MILLION_TOKENS=
LLM_OUTPUT_COST_PER_MILLION_TOKENS=
LLM_PRICING_VERSION=
MOCK_LLM=true
LOG_LEVEL=INFO
STORAGE_ROOT=/app/storage
MAX_UPLOAD_SIZE_MB=10

